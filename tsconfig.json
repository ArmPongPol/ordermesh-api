{
  // ts-node resolves files on demand from the entry point, so a global
  // declaration that nothing imports - src/auth/types/express.d.ts, which
  // augments Express.Request with `user` - is invisible to it, and
  // `npm run docs:json` / `seed:admin` fail on a type that `tsc` and
  // `nest build` both accept. `files: true` makes ts-node honour the project's
  // include set the way a full compile does.
  "ts-node": { "files": true },
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  }
}
