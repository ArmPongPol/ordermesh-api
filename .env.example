# ---------------------------------------------------------------------------
# Copy to .env.development (or .env.production / .env.local) and fill in.
# Only this example file is tracked by git.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=OrderMesh
# development | production | local
NODE_ENV=development
PORT=3001
HOST=localhost
API_PREFIX=api
API_VERSION=v1

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list. Required when NODE_ENV=production.
# Leave empty outside production to allow any origin.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Rate limiting (global ThrottlerGuard)
# ---------------------------------------------------------------------------
# TTL in milliseconds, limit = requests per TTL per IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ordermesh
# Must be false in production (enforced by env.validation.ts). Use migrations.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# ---------------------------------------------------------------------------
# Health check thresholds (megabytes)
# ---------------------------------------------------------------------------
# A Node process routinely exceeds 150 MB RSS - low values make /health flap
# and restart otherwise-healthy containers.
HEALTH_HEAP_MB=512
HEALTH_RSS_MB=1024

# ---------------------------------------------------------------------------
# API Docs (Swagger)
# ---------------------------------------------------------------------------
# Forced to false when NODE_ENV=production.
DOCS_ENABLED=true
DOCS_TITLE=OrderMesh API
DOCS_DESCRIPTION=OrderMesh API Documentation
DOCS_VERSION=1.0.0
DOCS_PATH=docs
