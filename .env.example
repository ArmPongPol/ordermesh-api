# ---------------------------------------------------------------------------
# Copy to .env.development (or .env.production / .env.local) and fill in.
# Only this example file is tracked by git.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=OrderMesh
# development | production | local
NODE_ENV=development
PORT=3001
HOST=localhost
API_PREFIX=api
API_VERSION=v1

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list. Required when NODE_ENV=production.
# Leave empty outside production to allow any origin.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Rate limiting (global ThrottlerGuard)
# ---------------------------------------------------------------------------
# TTL in milliseconds, limit = requests per TTL per IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ordermesh
# Must be false in production (enforced by env.validation.ts). Use migrations.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# ---------------------------------------------------------------------------
# Health check thresholds (megabytes)
# ---------------------------------------------------------------------------
# A Node process routinely exceeds 150 MB RSS - low values make /health flap
# and restart otherwise-healthy containers.
HEALTH_HEAP_MB=512
HEALTH_RSS_MB=1024

# ---------------------------------------------------------------------------
# API Docs (Swagger)
# ---------------------------------------------------------------------------
# Forced to false when NODE_ENV=production.
DOCS_ENABLED=true
DOCS_TITLE=OrderMesh API
DOCS_DESCRIPTION=OrderMesh API Documentation
DOCS_VERSION=1.0.0
DOCS_PATH=docs

# ---------------------------------------------------------------------------
# Authentication (JWT + RBAC)
# ---------------------------------------------------------------------------
# REQUIRED in every environment - the app refuses to boot without it, because a
# defaulted signing key is a backdoor. Generate one with:
#   openssl rand -base64 48
# Production additionally requires >= 48 chars and rejects this placeholder.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ISSUER=ordermesh-api
JWT_AUDIENCE=ordermesh-web
# Access tokens cannot be revoked, so this is the worst-case window for a
# stolen one. Capped at 3600 in production.
JWT_ACCESS_TTL_SECONDS=900

# Refresh token sliding window, and the hard ceiling for a rotation family.
# The absolute value must be >= the sliding one.
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_ABSOLUTE_TTL_DAYS=90

# Upper bound on how stale a cached permission/status snapshot may be.
# 0 disables caching (default outside production, so tests see writes at once).
# Production defaults to 30000; that is the window in which a revoked role or a
# suspension is still honoured on cached requests.
AUTH_PERMISSION_CACHE_TTL_MS=0

# Credential endpoints only (login / register / refresh). The global
# THROTTLE_LIMIT still applies underneath and catches stuffing across
# many emails. Tracked per (IP, email) pair.
AUTH_LOGIN_THROTTLE_LIMIT=5
AUTH_LOGIN_THROTTLE_TTL=60000
# Lockout once the limit trips, in ms.
AUTH_LOGIN_BLOCK_MS=900000

# Read only by `npm run seed:admin`, never by the running app. Omit both to
# disable the bootstrap seeder.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
