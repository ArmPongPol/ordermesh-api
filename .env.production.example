# ---------------------------------------------------------------------------
# Production template. Copy to .env.production and fill in real values.
# Never commit .env.production.
# ---------------------------------------------------------------------------

APP_NAME=OrderMesh
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
API_PREFIX=api
API_VERSION=v1

# Required in production - the app rejects requests from origins not listed.
CORS_ORIGINS=https://app.example.com
CORS_CREDENTIALS=true

THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Health check thresholds in megabytes. Keep below the container memory limit.
HEALTH_HEAP_MB=512
HEALTH_RSS_MB=1024

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=ordermesh
# Enforced to false in production - schema changes go through migrations only.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=true

# Enforced to false in production - Swagger is never exposed publicly.
DOCS_ENABLED=false
DOCS_TITLE=OrderMesh API
DOCS_DESCRIPTION=OrderMesh API Documentation
DOCS_VERSION=1.0.0
DOCS_PATH=docs

# ---------------------------------------------------------------------------
# Authentication (JWT + RBAC)
# ---------------------------------------------------------------------------
# REQUIRED. Must be >= 48 chars, and the placeholder below is explicitly
# rejected in production - generate a real one:
#   openssl rand -base64 48
# Rotating this value invalidates every outstanding access token immediately.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ISSUER=ordermesh-api
JWT_AUDIENCE=ordermesh-web
JWT_ACCESS_TTL_SECONDS=900

AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_ABSOLUTE_TTL_DAYS=90

# NOTE: this cache is per process. With more than one instance, a revoked role
# or a suspension can take up to this long to be honoured on every instance.
AUTH_PERMISSION_CACHE_TTL_MS=30000

AUTH_LOGIN_THROTTLE_LIMIT=5
AUTH_LOGIN_THROTTLE_TTL=60000
AUTH_LOGIN_BLOCK_MS=900000
